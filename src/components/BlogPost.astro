---
/**
 * Render de un post individual. Inyecta Article schema (autor + fechas => E-E-A-T
 * y frescura) y migas de pan.
 */
import { render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import type { Locale } from '../consts';
import { useTranslations, localizedPath } from '../i18n/ui';
import { articleSchema, breadcrumbSchema } from '../lib/schema';

interface Props {
  post: CollectionEntry<'blog'>;
  locale: Locale;
}
const { post, locale } = Astro.props;
const t = useTranslations(locale);
const { Content } = await render(post);

const postPath = `${localizedPath('/blog', locale)}/${post.data.slug}`;

const dateFmt = new Intl.DateTimeFormat(locale === 'es' ? 'es-ES' : 'en-US', { dateStyle: 'long' });

const pageSchema = [
  breadcrumbSchema([
    { name: t('nav.home'), path: localizedPath('/', locale) },
    { name: t('nav.blog'), path: localizedPath('/blog', locale) },
    { name: post.data.title, path: postPath },
  ]),
  articleSchema({
    title: post.data.title,
    description: post.data.description,
    path: postPath,
    locale,
    datePublished: post.data.pubDate.toISOString(),
    dateModified: (post.data.updatedDate ?? post.data.pubDate).toISOString(),
    authorName: post.data.author,
  }),
];
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  path={`/blog/${post.data.slug}`}
  locale={locale}
  type="article"
  publishedTime={post.data.pubDate.toISOString()}
  modifiedTime={(post.data.updatedDate ?? post.data.pubDate).toISOString()}
  schema={pageSchema}
>
  <article class="container post">
    <nav aria-label="Breadcrumb" class="muted post__crumbs">
      <a href={localizedPath('/blog', locale)}>← {t('blog.backToList')}</a>
    </nav>
    <h1>{post.data.title}</h1>
    <p class="muted">
      {t('blog.published')}
      <time datetime={post.data.pubDate.toISOString()}>{dateFmt.format(post.data.pubDate)}</time>
      · {post.data.author}
      {
        post.data.updatedDate && (
          <>
            {' · '}
            {t('footer.updated')}:{' '}
            <time datetime={post.data.updatedDate.toISOString()}>
              {dateFmt.format(post.data.updatedDate)}
            </time>
          </>
        )
      }
    </p>
    <div class="post__body">
      <Content />
    </div>
  </article>

  <style>
    .post {
      max-width: 48rem;
    }
    .post__crumbs {
      margin-bottom: 1rem;
    }
    .post__body :global(h2) {
      margin-top: 2rem;
    }
    .post__body :global(blockquote) {
      border-left: 4px solid var(--color-accent);
      padding-left: 1rem;
      margin-inline: 0;
      color: var(--color-muted);
      font-style: italic;
    }
  </style>
</BaseLayout>
