---
/**
 * BaseHead: todas las etiquetas del <head> que importan para SEO/AEO/GEO.
 * - title / meta description / canonical absoluto
 * - robots (con max-snippet:-1 para NO limitar lo que las IAs pueden citar)
 * - hreflang bidireccional (es, en) + x-default
 * - Open Graph + Twitter Cards
 * Documentado por qué cada etiqueta está aquí.
 */
import { SITE, LOCALE_BCP47, type Locale } from '../../consts';
import { localizedPath, withBase } from '../../i18n/ui';

interface Props {
  title: string;
  description: string;
  /** Ruta lógica SIN prefijo de idioma, p. ej. "/" o "/blog/mi-post". Para hreflang. */
  path?: string;
  locale: Locale;
  /** Imagen OG absoluta o relativa al dominio (1200x630). */
  image?: string;
  /** "website" para landing, "article" para posts. */
  type?: 'website' | 'article';
  noindex?: boolean;
  /** ISO dates para artículos (señal de frescura, clave en GEO). */
  publishedTime?: string;
  modifiedTime?: string;
}

const {
  title,
  description,
  path = '/',
  locale,
  image = SITE.defaultOgImage,
  type = 'website',
  noindex = false,
  publishedTime,
  modifiedTime,
} = Astro.props;

// Canonical SIEMPRE absoluto (requisito de Google). localizedPath ya incluye la base.
const canonicalURL = new URL(localizedPath(path, locale), SITE.url);
// La imagen puede ser ruta de asset cruda ("/og/..") o ya absoluta (http...).
const ogImageURL = /^https?:\/\//.test(image)
  ? new URL(image)
  : new URL(withBase(image), SITE.url);

// Alternates hreflang: una entrada por idioma + x-default -> idioma por defecto.
const alternates = SITE.locales.map((l) => ({
  hreflang: LOCALE_BCP47[l as Locale],
  href: new URL(localizedPath(path, l as Locale), SITE.url).href,
}));
const xDefaultHref = new URL(localizedPath(path, SITE.defaultLocale), SITE.url).href;

// robots: por defecto indexable y sin límites de snippet para buscadores E IAs.
const robots = noindex
  ? 'noindex, nofollow'
  : 'index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1';
---

{/* Básico */}
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />
<meta name="robots" content={robots} />
<link rel="canonical" href={canonicalURL.href} />
<meta name="generator" content={Astro.generator} />
<meta name="theme-color" content="#1f4ed8" />

{/* hreflang bidireccional + x-default (return tags obligatorios) */}
{
  alternates.map((alt) => (
    <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />
  ))
}
<link rel="alternate" hreflang="x-default" href={xDefaultHref} />

{/* Open Graph */}
<meta property="og:type" content={type} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalURL.href} />
<meta property="og:image" content={ogImageURL.href} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:locale" content={LOCALE_BCP47[locale]} />
{
  SITE.locales
    .filter((l) => l !== locale)
    .map((l) => <meta property="og:locale:alternate" content={LOCALE_BCP47[l as Locale]} />)
}
{type === 'article' && publishedTime && (
  <meta property="article:published_time" content={publishedTime} />
)}
{type === 'article' && modifiedTime && (
  <meta property="article:modified_time" content={modifiedTime} />
)}

{/* Twitter Cards (summary_large_image: mayor engagement) */}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageURL.href} />
{SITE.twitterHandle && <meta name="twitter:site" content={SITE.twitterHandle} />}

{/* Feeds descubribles por crawlers */}
<link rel="alternate" type="application/rss+xml" title={`${SITE.name} — RSS`} href={new URL(withBase('/rss.xml'), SITE.url).href} />

{/* Rendimiento: pista temprana al origen (ayuda al LCP si sirves assets propios) */}
<link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
