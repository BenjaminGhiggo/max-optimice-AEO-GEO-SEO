---
/**
 * Listado del blog para un idioma. Ordena por fecha (más reciente primero)
 * para exponer primero el contenido fresco.
 */
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import type { Locale } from '../consts';
import { useTranslations, localizedPath } from '../i18n/ui';
import { breadcrumbSchema } from '../lib/schema';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);

const posts = (await getCollection('blog', (p) => p.data.lang === locale && !p.data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const heading = locale === 'es' ? 'Blog' : 'Blog';
const intro =
  locale === 'es'
    ? 'Guías sobre SEO, AEO y GEO para que tu contenido sea encontrado y citado.'
    : 'Guides on SEO, AEO and GEO so your content gets found and cited.';

const dateFmt = new Intl.DateTimeFormat(locale === 'es' ? 'es-ES' : 'en-US', {
  dateStyle: 'long',
});

const pageSchema = [
  breadcrumbSchema([
    { name: t('nav.home'), path: localizedPath('/', locale) },
    { name: t('nav.blog'), path: localizedPath('/blog', locale) },
  ]),
];
---

<BaseLayout
  title={t('nav.blog')}
  description={intro}
  path="/blog"
  locale={locale}
  image={`/og/${locale}/blog.png`}
  schema={pageSchema}
>
  <section class="container">
    <h1>{heading}</h1>
    <p class="muted">{intro}</p>
    <div class="grid grid--2">
      {
        posts.map((post) => (
          <article class="card">
            <h2>
              <a href={`${localizedPath('/blog', locale)}/${post.data.slug}`}>{post.data.title}</a>
            </h2>
            <p class="muted">
              <time datetime={post.data.pubDate.toISOString()}>
                {dateFmt.format(post.data.pubDate)}
              </time>
            </p>
            <p>{post.data.description}</p>
            <a href={`${localizedPath('/blog', locale)}/${post.data.slug}`}>{t('blog.readMore')} →</a>
          </article>
        ))
      }
    </div>
  </section>
</BaseLayout>
